{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haio-gats:draft:schema:authority-grant:0.1",
  "title": "HAIO-GATS draft authority grant",
  "description": "Non-normative candidate encoding of AU-01 through AU-05.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "operation_id",
    "grantor_id",
    "grantee_id",
    "grantee_identity_binding",
    "role",
    "permitted_actions",
    "resource_scope",
    "constraints",
    "effective_at",
    "expires_at",
    "terminal_conditions",
    "required_evidence",
    "approval_gates",
    "prohibited_actions",
    "revocation",
    "issued_at",
    "policy_id",
    "policy_version",
    "signature_ref"
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "properties": {
    "schema_version": { "const": "haio-gats.authority-grant/draft-0.1" },
    "grant_id": { "$ref": "#/$defs/identifier" },
    "operation_id": { "$ref": "#/$defs/identifier" },
    "grantor_id": { "$ref": "#/$defs/identifier" },
    "grantee_id": { "$ref": "#/$defs/identifier" },
    "grantee_identity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject", "assurance_method"],
      "properties": {
        "issuer": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" },
        "assurance_method": { "type": "string", "minLength": 1 }
      }
    },
    "role": { "type": "string", "minLength": 1 },
    "permitted_actions": { "$ref": "#/$defs/stringSet", "minItems": 1 },
    "resource_scope": { "$ref": "#/$defs/stringSet", "minItems": 1 },
    "constraints": { "type": "array", "items": { "type": "object", "minProperties": 1 } },
    "effective_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "terminal_conditions": { "$ref": "#/$defs/stringSet" },
    "required_evidence": { "$ref": "#/$defs/stringSet" },
    "approval_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "transition", "required_approver_role"],
        "properties": {
          "gate_id": { "$ref": "#/$defs/identifier" },
          "transition": { "type": "string", "minLength": 1 },
          "required_approver_role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prohibited_actions": { "$ref": "#/$defs/stringSet", "minItems": 1 },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at"],
      "properties": {
        "status": { "type": "string", "enum": ["active", "revoked", "expired", "terminated"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "revoked_at": { "type": "string", "format": "date-time" },
        "revocation_event_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "policy_version": { "type": "string", "minLength": 1 },
    "signature_ref": { "$ref": "#/$defs/identifier" }
  }
}
