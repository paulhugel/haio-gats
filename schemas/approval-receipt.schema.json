{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haio-gats:draft:schema:approval-receipt:0.1",
  "title": "HAIO-GATS draft approval receipt",
  "description": "Non-normative candidate for binding an authenticated human decision to one exact proposed action. It is not a transparency receipt profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "operation_id",
    "submission_id",
    "gate_id",
    "transition",
    "human_supervisor_id",
    "supervisor_identity_binding",
    "authority_grant_id",
    "policy_id",
    "policy_version",
    "decision",
    "action_digest",
    "resource_scope_digest",
    "input_set_digest",
    "constraints",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce",
    "receipt_use_policy",
    "signature"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": { "enum": ["unknown", "not_applicable"] }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha-256"] },
        "canonicalization": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject", "credential_id", "authenticated_at", "assurance_method"],
      "properties": {
        "issuer": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" },
        "credential_id": { "$ref": "#/$defs/identifier" },
        "authenticated_at": { "$ref": "#/$defs/timestamp" },
        "assurance_method": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "haio-gats.approval-receipt/draft-0.1" },
    "approval_id": {
      "allOf": [{ "$ref": "#/$defs/identifier" }],
      "description": "Globally unique receipt identifier. Stateful enforcement MUST reject reuse contrary to receipt_use_policy."
    },
    "operation_id": { "$ref": "#/$defs/identifier" },
    "submission_id": { "$ref": "#/$defs/identifier" },
    "gate_id": { "$ref": "#/$defs/identifier" },
    "transition": { "$ref": "#/$defs/identifier" },
    "human_supervisor_id": { "$ref": "#/$defs/identifier" },
    "supervisor_identity_binding": {
      "allOf": [{ "$ref": "#/$defs/identityBinding" }],
      "description": "The authenticated subject MUST equal human_supervisor_id; JSON Schema validation alone does not enforce cross-field equality."
    },
    "authority_grant_id": { "$ref": "#/$defs/identifier" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "policy_version": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["approved", "rejected", "constrained", "paused", "halted"] },
    "action_digest": { "$ref": "#/$defs/digest" },
    "resource_scope_digest": { "$ref": "#/$defs/digest" },
    "input_set_digest": { "$ref": "#/$defs/digest" },
    "constraints": { "type": "array", "items": { "type": "object", "minProperties": 1 } },
    "decision_basis_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "nonce": { "type": "string", "minLength": 16 },
    "receipt_use_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "consumption_registry", "reuse_behavior"],
      "properties": {
        "mode": { "const": "single_use" },
        "consumption_registry": { "$ref": "#/$defs/identifier" },
        "reuse_behavior": { "const": "fail_closed" }
      },
      "description": "Declares the required stateful replay control. Schema validation does not prove that the receipt is unconsumed or atomically consumed."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "algorithm", "key_id", "value"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 },
        "key_id": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "transparency_statement_id": { "$ref": "#/$defs/identifier" },
    "transparency_receipt_ref": { "$ref": "#/$defs/identifier" }
  }
}
